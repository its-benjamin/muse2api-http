# Required: one or more Netscape cookie files exported from a logged-in muse.ai session.
# Comma-separated paths enable the account pool.
MUSE_COOKIE_FILE=cookies_muse.txt
# MUSE_COOKIE_FILES=cookies_a.txt,cookies_b.txt

# OpenAI-compatible server
MUSE2API_HOST=127.0.0.1
MUSE2API_PORT=18610
MUSE2API_KEY=
MUSE_MODEL=muse-spark
MUSE_TIMEZONE=UTC

MUSE_STATE_DIR=.muse-state

# thread = one muse side-chat per API session (recommended, keeps context)
# main   = the account's main chat
MUSE_SESSION_MODE=thread
MUSE_CHAT_TIMEOUT=300
MUSE_SESSION_CACHE=45
MUSE_LISTEN_MS=90000
MUSE_LOG_LEVEL=info

# Concurrency limits.
# Set to "auto" (default) to scale automatically with the pool size (accounts * concurrency_per_account).
# 1 account = 2 concurrent slots; 3 accounts = 6 slots; etc. Or set a fixed integer cap.
MUSE2API_CONCURRENCY=auto
MUSE2API_CONCURRENCY_PER_ACCOUNT=2
MUSE_IMAGE_TIMEOUT=240
MUSE_VIDEO_TIMEOUT=600
MUSE_REQUEST_TIMEOUT=60
# Pause keepalive and release idle sessions after this many seconds (0 disables, e.g. 300 for 5 min).
MUSE_IDLE_SLEEP_SECONDS=1800

# Cookie preservation: renew rolling session cookies via /api/session every N seconds.
# Runs in the background even during idle sleep to prevent Meta/muse cookie expiry (default: 7200 = 2 hours).
MUSE_COOKIE_RENEW_SECONDS=7200

# Answer agent permission prompts for the waiting chat thread.
# Hosting profiles:
#   - Public / Restricted (safe OpenAI-like API): MUSE2API_APPROVAL_POLICY=deny
#     Immediately denies web egress, file uploads, and connectors. The model fails
#     fast with a polite refusal rather than hanging for 5 minutes.
#   - Private / Self-Hosted (full agent capabilities): MUSE2API_APPROVAL_POLICY=settings
#     Follows your muse.ai web UI settings, auto-approving permitted actions.
#   - Default: off (never answers; turns wait for human approval or timeout).
# Security-sensitive: granting approvals exposes your account's network and tools.
MUSE2API_APPROVAL_POLICY=off
# When "settings" resolves a prompt to ask, answer it with this policy.
MUSE2API_APPROVAL_ASK=allow_once
# Absolute media URL prefix when clients cannot resolve /v1/media relative to the API.
# MUSE2API_PUBLIC_BASE=https://api.example.com/v1/media
# Reference-image URLs must resolve to public hosts; opt out only for LAN sources.
# MUSE2API_ALLOW_PRIVATE_URLS=1
# After a region refusal, reject new video tasks for this many seconds.
# MUSE_VIDEO_BLOCK_SECONDS=21600

# Browser fingerprint (curl_cffi resolves `chrome` to its newest bundled build,
# currently Chrome 150). Use `firefox` if an account is UA-bound.
MUSE_IMPERSONATE=chrome
# Pinned to HTTP/2: the Chrome profile's h2 fingerprint is exact, while libcurl's
# HTTP/3 stack does not match Chromium's QUIC transport parameters. `auto`/`3`
# opt back into HTTP/3.
MUSE_HTTP_VERSION=2
# Egress proxy & proxy pool for muse.ai HTTP + WebSocket + media traffic.
# Single proxy:
# MUSE_PROXY=socks5://user:pass@127.0.0.1:1080
#
# Proxy Pool (multiple proxies, comma-separated or from file):
# MUSE_PROXIES=http://proxy1:8080,socks5://proxy2:1080,http://proxy3:8080
# MUSE_PROXY_FILE=proxies.txt
#
# Rotation strategy: smart (fitness/health-aware, skips failing proxies), round-robin, random, fill-first
# MUSE_PROXY_STRATEGY=smart
# Cooldown seconds for failed/rate-limited proxies before re-trying (default: 300 = 5 min)
# MUSE_PROXY_COOLDOWN=300
# Off by default: the stdlib `websockets` fallback uses Python/OpenSSL and thus a
# different TLS fingerprint from the Chrome profile. Enable only as a last resort.
# MUSE_WS_FALLBACK=1
# Optional: match the exact UA of the browser that exported the cookies
# MUSE_USER_AGENT=Mozilla/5.0 (Windows NT 10.0; Win64; x64; rv:158.0) Gecko/20100101 Firefox/158.0

# Optional protocol overrides (normally discovered from the web bundle)
# MUSE_LB_HOST=hatch.metaaivm.com
# MUSE_WS_PATH=/v1/noise
# MUSE_APP_ID=hatch-web

# Optional confidential-VM support. Standard VMs do not need either value.
# Without both, a CVM challenge fails closed instead of downgrading.
# MUSE_CVM_RV_KEY=<32-byte hex or base64 recovery key>
# MUSE_ATTESTATION_CMD=node verify-attestation.mjs
